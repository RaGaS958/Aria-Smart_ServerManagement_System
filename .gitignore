# ─────────────────────────────────────────────────────────────────
#  ARIA System — .gitignore  (project root)
#  Covers: backend (FastAPI/Python) + frontend (React/Vite)
# ─────────────────────────────────────────────────────────────────

# ════════════════════════════════════════════════
#  PYTHON  (backend/)
# ════════════════════════════════════════════════

__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
MANIFEST

# Virtual environment — project-specific name
backend/ariavenv/
venv/
.venv/
env/
ENV/
.python-version

# Testing & Coverage
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
coverage.xml
*.cover
report.json

# FastAPI / Uvicorn
*.log
logs/
*.pid

# SQLite database (re-created at runtime)
*.db
*.sqlite3

# ════════════════════════════════════════════════
#  NODE / FRONTEND  (frontend/)
# ════════════════════════════════════════════════

node_modules/
frontend/node_modules/

# Vite build output
frontend/dist/
frontend/build/
frontend/.vite/
*.tsbuildinfo

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ════════════════════════════════════════════════
#  ENVIRONMENT VARIABLES
# ════════════════════════════════════════════════

.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
# Keep examples tracked
!.env.example
!backend/.env.example
!frontend/.env.example

# ════════════════════════════════════════════════
#  IDEs & EDITORS
# ════════════════════════════════════════════════

.vscode/
.idea/
*.swp
*.swo
*~

# ════════════════════════════════════════════════
#  OS FILES
# ════════════════════════════════════════════════

.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# ════════════════════════════════════════════════
#  MISC
# ════════════════════════════════════════════════

*.bak
*.tmp
*.orig
.cache/
.mypy_cache/
.ruff_cache/
.pytype/
